<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UserInterface.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UserInterface"
    Title="UserInterface">
    <FlyoutItem Title="Gravar">
        <ShellContent ContentTemplate="{DataTemplate local:CirurgiasPlanejadasPagina}"/>
    </FlyoutItem>
    <FlyoutItem Title="Gravações">
        <ShellContent ContentTemplate="{DataTemplate local:CirurgiasFinalizadasPagina}"/>
    </FlyoutItem>
    <FlyoutItem Title="Configuração">
        <ShellContent ContentTemplate="{DataTemplate local:ConfiguracaoPagina}"/>
    </FlyoutItem>
</Shell>
